#!/bin/sh
set -eu
hooks=$(git rev-parse --git-path hooks)
sh "$hooks/check-identity" current
zero=$(git hash-object --stdin </dev/null | sed 's/./0/g')

while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$local_oid" != "$zero" ] || continue
    if [ "$remote_oid" = "$zero" ]; then
        commits=$(git rev-list "$local_oid" --not --remotes="$1") || exit 1
    else
        if ! git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
            printf '%s\n' '缺少远端基准提交，请先获取远端更新并核对历史。' >&2
            exit 1
        fi
        commits=$(git rev-list "$local_oid" "^$remote_oid") || exit 1
    fi
    for commit in $commits; do
        sh "$hooks/check-identity" "$commit"
    done
done
